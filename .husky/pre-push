printf '%s\n' '[husky][pre-push] Running lint and prettier checks'

if ! pnpm format:check; then
    status=$?
    printf '%s\n' '[husky][pre-push] Code formatting issues found. Push blocked.'
    exit $status
fi

if ! pnpm lint; then
    status=$?
    printf '%s\n' '[husky][pre-push] Linting issues found. Push blocked.'
    exit $status
fi

printf '%s\n' '[husky][pre-push] All checks passed. Proceeding with push.'