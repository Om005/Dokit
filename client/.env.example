NEXT_PUBLIC_BACKEND_URL=<for example "http://localhost:4000" if your backend is running on localhost:4000>
NEXT_PUBLIC_NGINX_HOST=<for example "localhost:8080" if your nginx is running on localhost:8080>
NEXT_PUBLIC_EDITOR_SOCKET_URL=<for example "ws://localhost:4000" if your backend is running on localhost:4000>
NEXT_PUBLIC_PROJECT_SOCKET_URL=<for example "http://localhost:4000" if your backend is running on localhost:4000>
NEXT_PUBLIC_FORM_ACCESS_KEY=<your-access-key-here>