        "eslint-config-next": "16.1.6",
        "globals": "^15.0.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "next": "16.1.6",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.0.0"
    }
