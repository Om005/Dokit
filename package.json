    "main": "index.js",
    "scripts": {
        "format": "prettier --write \"**/*.{js,ts,tsx,json,css}\"",
        "format:check": "prettier --check \"**/*.{js,ts,tsx,json,css}\"",
        "lint": "eslint \"client/**/*.{js,jsx,ts,tsx}\" \"server/**/*.{js,jsx,ts,tsx}\"",
        "test": "echo \"Error: no test specified\" && exit 1",
        "docker:up": "docker compose -f server/docker-compose.yaml up -d",
        "dev": "pnpm run docker:up && pnpm --parallel --filter ./server --filter ./client dev",
        "down": "docker compose -f server/docker-compose.yaml down",
        "prepare": "husky"
    },
    "keywords": [],
